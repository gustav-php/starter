{
    "name": "gustav-php/starter",
    "description": "Starter project for Gustav PHP.",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Torsten Dittmann",
            "email": "torsten.dittmann@googlemail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "gustav-php/gustav": "^1.0@RC"
    },
    "require-dev": {
        "laravel/pint": "^1.30.4",
        "nyholm/psr7": "^1.8"
    },
    "scripts": {
        "test": "@php tests/smoke.php",
        "lint": "./vendor/bin/pint --test --config vendor/gustav-php/gustav/pint.json src app tests",
        "format": "./vendor/bin/pint --config vendor/gustav-php/gustav/pint.json src app tests",
        "setup": "@php ./vendor/bin/rr get-binary --no-config",
        "post-create-project-cmd": [
            "composer run setup",
            "@php gustav installed"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2.0"
        }
    }
}
